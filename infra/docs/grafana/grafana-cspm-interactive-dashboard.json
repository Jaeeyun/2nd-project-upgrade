      {
        "id": 100,
        "title": "🏷️ 태그/규칙 기반 자동 억제 이력 (Automation Rules)",
        "description": "46-cspm-automation-rules.tf의 Automation Rule이 Security Hub 파이프라인 안에서 즉시 억제한 finding들 - Lambda를 아예 거치지 않아 CloudWatch Logs (위 4개 패널의 소스)엔 흔적이 안 남는다. Security Lake(OCSF)의 원본 Note.UpdatedBy로 automation-rule-* 태그가 붙은 것만 골라서 보여준다. '명시적 억제 태그' 규칙은 Environment=suppresstag가 리소스에 개별적으로 붙어있어야만 걸린다(전체 계정에 깔린 Environment=dev와는 분리됨 - HIGH 심각도 finding까지 광범위하게 묻히는 문제가 있어서 좁혔음). Slack 모달로 사람이 수동 승인한 예외(Note.UpdatedBy가 Slack 사용자명)는 여기 안 잡히고, 위 '실시간 예외 등록 감사 내역' 패널에 따로 뜬다.",
        "type": "table",
        "gridPos": {
          "x": 0,
          "y": 16,
          "w": 24,
          "h": 8
        },
        "datasource": {
          "type": "grafana-athena-datasource",
          "uid": "ffuxh6qmezlz4a"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "grafana-athena-datasource",
              "uid": "ffuxh6qmezlz4a"
            },
            "connectionArgs": {
              "catalog": "AwsDataCatalog",
              "database": "amazon_security_lake_glue_db_ap_northeast_2",
              "region": "ap-northeast-2"
            },
            "rawSQL": "WITH latest AS (SELECT finding_info.uid as uid, finding_info.title as title, severity, status, resource.type as resource_type, resource.labels as labels, unmapped['Note.UpdatedBy'] as suppressed_by, unmapped['Note.UpdatedAt'] as suppressed_at, time_dt, ROW_NUMBER() OVER (PARTITION BY finding_info.uid ORDER BY time_dt DESC) as rn FROM amazon_security_lake_table_ap_northeast_2_sh_findings_2_0) SELECT title, resource_type, severity, suppressed_by, suppressed_at, array_join(labels, ', ') as tags FROM latest WHERE rn = 1 AND status = 'Suppressed' AND suppressed_by LIKE 'automation-rule-%' ORDER BY suppressed_at DESC LIMIT 50",
            "format": "table"
          }
        ],
        "options": {
          "showHeader": true,
          "sortBy": [
            {
              "displayName": "suppressed_at",
              "desc": true
            }
          ]
        },
        "fieldConfig": {
          "defaults": {},
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "suppressed_by"
              },
              "properties": [
                {
                  "id": "custom.cellOptions",
                  "value": {
                    "type": "color-background",
                    "mode": "basic"
                  }
                },
                {
                  "id": "mappings",
                  "value": [
                    {
                      "type": "value",
                      "options": {
                        "automation-rule-suppress-dev-tagged": {
                          "color": "blue",
                          "text": "🏷️ 명시적 억제 태그(suppresstag)"
                        },
                        "automation-rule-suppress-known-accepted-risks": {
                          "color": "purple",
                          "text": "📋 기존 위험수용 재발 자동억제"
                        }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
